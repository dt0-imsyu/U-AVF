[Unit]
Description=U-AVF bounded guest control connection

[Service]
ExecStart=/usr/bin/python3 /usr/local/sbin/uavf-control.py
StandardInput=socket
StandardOutput=socket
StandardError=journal
NoNewPrivileges=yes
# Keep /usr and /etc protected, but the ext4 root mount must remain writable
# inside this namespace for the online resize ioctl on the managed /dev/vda3.
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes
TimeoutStopSec=3
