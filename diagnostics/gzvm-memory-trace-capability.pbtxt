# Three-second provider capability check only; no GPU configuration change.
duration_ms: 3000
buffers { size_kb: 2048 fill_policy: RING_BUFFER }
data_sources { config {
  name: "linux.ftrace"
  ftrace_config {
    ftrace_events: "sched/sched_switch"
    ftrace_events: "printk/console"
    ftrace_events: "raw_syscalls/sys_enter"
    ftrace_events: "raw_syscalls/sys_exit"
  }
} }
